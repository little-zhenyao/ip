<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="550.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="windy.ui.MainWindow">
    <children>
        <Label alignment="CENTER"
               contentDisplay="CENTER"
               prefHeight="17.0"
               prefWidth="550.0"
               text="Windy"
               textAlignment="CENTER"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0" />
        <HBox alignment="CENTER"
              prefHeight="56.0"
              spacing="8.0"
              styleClass="input-container"
              AnchorPane.bottomAnchor="6.0"
              AnchorPane.leftAnchor="6.0"
              AnchorPane.rightAnchor="6.0">
            <children>
                <TextField fx:id="userInput"
                           onAction="#handleUserInput"
                           prefHeight="44.0"
                           promptText="What would you like Windy to do?"
                           HBox.hgrow="ALWAYS" />
                <Button fx:id="sendButton"
                        mnemonicParsing="false"
                        onAction="#handleUserInput"
                        prefHeight="44.0"
                        prefWidth="112.0"
                        text="Send  →" />
            </children>
            <padding>
                <Insets bottom="6.0" left="10.0" right="6.0" top="6.0" />
            </padding>
        </HBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    hvalue="1.0"
                    layoutY="18.0"
                    prefHeight="539.0"
                    prefWidth="550.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="70.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="18.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="552.0" prefWidth="538.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
